---
import Layout from "../layouts/Layout.astro";
import ProfessionalExperience from "../components/ProfessionalExperience.astro";
import Education from "../components/Education.astro";
import AreasOfExpertise from "../components/AreasOfExpertise.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Colin Thompson">
	<header class="max-w-screen-xl left-1/2 -translate-x-1/2 px-6 pt-2 bg-white z-10">
		<div class="w-full border-b-4 border-black">
			<h1 class="text-left">Colin Thompson</h1>
		</div>
		<button class="nav-toggle md:hidden before:flex before:hidden" aria-label="Mobile Menu">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
		</button>
		<ul class="job-titles my-2 hidden md:flex flex-row gap-8 top-0">
			<li>Web Developer</li>
			<li>Full-Stack Developer</li>
			<li>Front-End Developer</li>
		</ul>
		<nav class="relative">
			<ul class="nav-menu my-2 flex hidden md:flex flex-col items-start md:flex-row md:justify-center md:gap-16">
				<li><a href="#professional-experience">Professional Experience</a></li>
				<li><a href="#education">Education</a></li>
				<li><a href="#areas-of-expertise">Areas Of Expertise</a></li>
				<li><a href="#certifications">Certifications</a></li>
				<li><a href="#contact">Contact</a></li>
			</ul>
		</nav>
	</header>
	<main class="max-w-screen mx-auto">
		<div id="welcome-message" class="text-center text-4xl font-bold mb-8 fixed left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 h-0">
			Welcome<br />I hope to chat soon.
		</div>
		<div class="p-6 flex md:justify-center">
			<p class="max-w-3xl md:text-center">Skilled Front-End Developer specializing in Web Development for 7 years with a light focus on Full-Stack development. Utilizes technical acumen and analytical skills to troubleshoot and provide effective solutions. Strong communicator with a collaborative approach to meet deadlines in a fast-paced environment.</p>
		</div>
		<ProfessionalExperience />
		<Education />
		<AreasOfExpertise />
		<Certifications />
		<Contact />
	</main>
</Layout>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
  
	gsap.registerPlugin(ScrollTrigger);
  
	// Ensure the DOM is fully loaded before running the script
	window.addEventListener('DOMContentLoaded', () => {
	  // Create a GSAP timeline
	  const tl = gsap.timeline();
  
	  // Welcome message animation
	  tl.fromTo("#welcome-message", 
		{ 
			opacity: 1,
			position: "fixed",
			top: "50%",
			yPercent: -50
		
		}, // Initial state
		{ 
		  opacity: 0,
			top: "0%",
			yPercent: 0,
			duration: 1,
			delay: 1,
			onComplete: () => {
			// Remove the welcome message from the DOM
			document?.getElementById("welcome-message").remove();
		},
		}
	  );
  
	  // Animation for the rest of the text
	  const textElements = document.querySelectorAll("h2, h3, p, li, strong");
  
	  tl.fromTo(textElements, 
		{
			opacity: 0,

		}, // Initial state
		{ 
		  opacity: 1, 
		  //y: 0, // Final state
		  y: "0",
		  duration: .5,
		  stagger: 0.2,
		  scrollTrigger: {
			trigger: textElements[0], // Use the first element as the trigger
			start: "top 95%",
			end: "bottom 10%",
			// Remove scrub for a more noticeable animation
		  },
		},
		"-=1" // Start this animation 1 second before the previous one ends
	  );
  
	  // Add event listeners to anchor links
	  const anchors = document.querySelectorAll('a[href^="#"]');
	  anchors.forEach(anchor => {
		anchor.addEventListener('click', (event) => {
		  event.preventDefault();
		  const targetId = anchor.getAttribute('href').substring(1);
		  const targetElement = document.getElementById(targetId);
  
		  if (targetElement) {
			// Cancel all ongoing animations on text elements
			gsap.killTweensOf(textElements);
  
			textElements.forEach(element => {
				gsap.to(element, { opacity: 1, y: 0, duration: 1 });
			});
  
  
			// Scroll to the target section
			targetElement.scrollIntoView({ behavior: 'smooth' });
		  } else {
			console.warn(`Element with ID ${targetId} not found.`);
		  }
		});
	  });
	});
  </script>
  

<style>
	header {
		width: 100%;
		position: fixed;
		min-height: var(--header-height);
		top: 0;
		display: grid;
		grid-template-rows: 1fr;
		grid-template-columns: 1fr;
		align-items: center;
		justify-items: center;
		text-align: center;
		overflow: hidden;
		border-bottom: 1px solid var(--wenge);
		background-color: white;
		color: var(--eerie-black);
		& button {
			grid-column-start: 2;
			&::before {
				content: "";
				background-image: url(../images/x-icon.svg);
				position: absolute;
				height: 24px;
				width: 24px;
				background-color: white;

			}
		}
		.job-titles {
			& li{
				font-size: 1.2rem;

				&:not(:first-child) {
					list-style-type: disc;
				}
			} 
		}
		& nav {
			width: 100%;
			grid-column: 1 / span 2;
			& .nav-menu li {
				width: 100%;
				a {
					display: block;
					position: relative;
					width: 100%;
					text-align: right;
					z-index: 20;
					@media screen and (min-width: 960px) {
						text-align: center;
						&::before {
							content: "";
							position: absolute;
							background-color: var(--wenge);
							bottom: 0;
							width: 2rem;
							height: 3px;
							z-index: -1;
							transition: all 0.3s;
						}
						&:hover, &:focus {
							&::before {
								background-color: var(--cordovan);
								width: 70%;
								height: 2px;

							}
						}
					}	
				}
			} 
		}
	}
	main {
		min-height: 100vh;
		padding-top: calc(var(--header-height) + 2rem);
		p, li, strong {
			opacity: 0;
		}
		@media screen and (min-width: 960px) {
				padding-top: calc(var(--header-height-desktop) + 2rem);
		}
	}
</style>
